# Startup Conclave 1.0 — Local Environment Example
# Copy this file to .env.local for local overrides.
# .env.local is gitignored and will never be committed.

# VITE_RECAPTCHA_SITE_KEY: Optional reCAPTCHA v3 or Enterprise site key for Firebase App Check.
# Configure this after registering your domain in Google reCAPTCHA.
# When left empty, Firebase App Check remains bypassed during development.
VITE_RECAPTCHA_SITE_KEY=""

GEMINI_API_KEY=""