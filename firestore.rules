rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Verify if user is authenticated and their email is in the designated admin roster
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && (request.auth.token.email in [
          'aaravgorewal@gmail.com',
          'admin@dvsiet.ac.in',
          'conclave@dvsiet.ac.in'
        ]);
    }

    // Helper: Validate attendee registration creation payload
    function isValidRegistration(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 120
        && data.phone is string && data.phone.size() >= 10 && data.phone.size() <= 15
        && data.college is string && data.college.size() > 0 && data.college.size() <= 150
        && data.status is string && data.status == 'registered'
        && (!('course' in data) || (data.course is string && data.course.size() <= 100))
        && (!('year' in data) || (data.year is string && data.year.size() <= 50))
        && (!('role' in data) || (data.role is string && data.role.size() <= 50))
        && (!('city' in data) || (data.city is string && data.city.size() <= 100))
        && (!('wantsToPitch' in data) || data.wantsToPitch is bool)
        && (!('startupName' in data) || (data.startupName is string && data.startupName.size() <= 150))
        && (!('startupPitch' in data) || (data.startupPitch is string && data.startupPitch.size() <= 1000))
        && (!('id' in data) || (data.id is string && data.id.size() <= 50))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50));
    }

    // Helper: Validate pitch data creation payload
    function isValidPitch(data) {
      return data.startupName is string && data.startupName.size() > 0 && data.startupName.size() <= 150
        && data.startupPitch is string && data.startupPitch.size() > 0 && data.startupPitch.size() <= 1000
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 120
        && (!('status' in data) || data.status == 'applied' || data.status == 'registered' || data.status == 'new')
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 25))
        && (!('id' in data) || (data.id is string && data.id.size() <= 50))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50));
    }

    // Helper: Validate partner inquiry creation payload
    function isValidPartnerEnquiry(data) {
      return data.company is string && data.company.size() > 0 && data.company.size() <= 150
        && data.contactName is string && data.contactName.size() > 0 && data.contactName.size() <= 100
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 120
        && data.status is string && data.status == 'new'
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 25))
        && (!('message' in data) || (data.message is string && data.message.size() <= 2000))
        && (!('id' in data) || (data.id is string && data.id.size() <= 50))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50));
    }

    // 1. Registrations Collection (including Pitch applications with wantsToPitch: true)
    match /registrations/{registrationId} {
      // Public users can only CREATE with validated fields and status fixed to 'registered'
      allow create: if isValidRegistration(request.resource.data);

      // Only signed-in users whose email is in the admin list may READ, UPDATE or DELETE
      allow read, update, delete: if isAdmin();
    }

    // 2. Pitch Data Collections
    match /pitches/{pitchId} {
      // Public users can only CREATE with validated pitch fields
      allow create: if isValidPitch(request.resource.data);

      // Only signed-in users whose email is in the admin list may READ, UPDATE or DELETE
      allow read, update, delete: if isAdmin();
    }

    match /pitchApplications/{pitchId} {
      // Public users can only CREATE with validated pitch fields
      allow create: if isValidPitch(request.resource.data);

      // Only signed-in users whose email is in the admin list may READ, UPDATE or DELETE
      allow read, update, delete: if isAdmin();
    }

    // 3. Partner Enquiries Collection
    match /partnerEnquiries/{enquiryId} {
      // Public users can only CREATE with validated fields and status fixed to 'new'
      allow create: if isValidPartnerEnquiry(request.resource.data);

      // Only signed-in users whose email is in the admin list may READ, UPDATE or DELETE
      allow read, update, delete: if isAdmin();
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
