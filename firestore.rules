rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to verify admin status
    function isAdmin() {
      return request.auth != null;
    }

    // Registrations collection
    match /registrations/{registrationId} {
      // Public can only CREATE a registration
      allow create: if request.resource.data.name is string
                    && request.resource.data.email is string
                    && request.resource.data.phone is string
                    && request.resource.data.college is string;

      // Only signed-in admins can READ, UPDATE or DELETE
      allow read, update, delete: if isAdmin();
    }

    // Partner Enquiries collection
    match /partnerEnquiries/{enquiryId} {
      // Public can only CREATE an enquiry
      allow create: if request.resource.data.company is string
                    && request.resource.data.contactName is string
                    && request.resource.data.email is string;

      // Only signed-in admins can READ, UPDATE or DELETE
      allow read, update, delete: if isAdmin();
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
