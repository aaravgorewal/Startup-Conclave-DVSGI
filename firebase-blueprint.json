{
  "entities": {
    "Counter": {
      "title": "Counter",
      "description": "Counter for atomic sequential registration ID allocation",
      "type": "object",
      "properties": {
        "currentCount": { "type": "number", "description": "Current sequential registration count" },
        "updatedAt": { "type": "string", "description": "Server timestamp of last increment" }
      },
      "required": ["currentCount", "updatedAt"]
    },
    "Registration": {
      "title": "Registration",
      "description": "Attendee registration for Startup Conclave 1.0",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "description": "Unique registration ID (e.g. SC1-00001)" },
        "registrationId": { "type": "string", "maxLength": 64, "description": "Sequential registration code (SC1-00001)" },
        "sequenceNumber": { "type": "number", "description": "Sequential integer counter" },
        "emailHash": { "type": "string", "maxLength": 128, "description": "Hash of email address" },
        "name": { "type": "string", "maxLength": 100, "description": "Full name of the attendee" },
        "email": { "type": "string", "format": "email", "maxLength": 120, "description": "Email address" },
        "phone": { "type": "string", "pattern": "^[0-9]{10}$", "description": "Exactly 10-digit WhatsApp/phone number" },
        "college": { "type": "string", "maxLength": 150, "description": "College or organisation name" },
        "course": { "type": "string", "maxLength": 100, "description": "Course name (for students)" },
        "year": { "type": "string", "maxLength": 50, "description": "Academic year (for students)" },
        "role": { "type": "string", "enum": ["Student", "Founder", "Professional", "Other"], "description": "Role: Student, Founder, Professional, Other" },
        "city": { "type": "string", "maxLength": 80, "description": "City of residence" },
        "notes": { "type": "string", "maxLength": 500, "description": "Admin notes" },
        "wantsToPitch": { "type": "boolean", "description": "Whether attendee wants to pitch in the Pitch Arena" },
        "startupName": { "type": "string", "maxLength": 150, "description": "Name of startup if wantsToPitch is true" },
        "startupPitch": { "type": "string", "maxLength": 1000, "description": "One-line pitch of startup if wantsToPitch is true" },
        "sector": { "type": "string", "maxLength": 100, "description": "Startup sector / domain" },
        "stage": { "type": "string", "maxLength": 50, "description": "Startup stage (Idea, Prototype, Launched, Revenue)" },
        "pitchDeckLink": { "type": "string", "maxLength": 1000, "description": "Validated Google Drive or Canva pitch deck link" },
        "teamSize": { "type": "string", "maxLength": 50, "description": "Number of founding/team members" },
        "pitchScores": { "type": "object", "description": "Jury criteria evaluation scores (1-10 per criterion)" },
        "pitchTotalScore": { "type": "number", "description": "Weighted total score out of 100" },
        "pitchStatus": { "type": "string", "maxLength": 50, "description": "Pitch screening status" },
        "status": { "type": "string", "enum": ["registered", "waitlist", "confirmed", "checked_in", "cancelled"], "description": "Registration status (registered, waitlist, confirmed, checked_in, cancelled)" },
        "createdAt": { "type": "string", "description": "Server timestamp of registration" }
      },
      "required": ["name", "email", "phone", "college", "role", "status", "createdAt"]
    },
    "PhoneIndex": {
      "title": "PhoneIndex",
      "description": "Deterministic phone index document for duplicate detection",
      "type": "object",
      "properties": {
        "registrationId": { "type": "string", "maxLength": 128, "description": "Associated registration document ID" },
        "emailHash": { "type": "string", "maxLength": 128, "description": "Hash of email address" },
        "phoneHash": { "type": "string", "maxLength": 128, "description": "Hash of 10-digit phone number" },
        "createdAt": { "type": "string", "description": "Server timestamp of phone index entry" }
      },
      "required": ["registrationId", "createdAt"]
    },
    "PartnerEnquiry": {
      "title": "PartnerEnquiry",
      "description": "Partnership inquiry from company or organisation",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "description": "Unique inquiry ID" },
        "company": { "type": "string", "maxLength": 150, "description": "Company name" },
        "contactName": { "type": "string", "maxLength": 100, "description": "Contact person name" },
        "email": { "type": "string", "format": "email", "maxLength": 120, "description": "Contact email" },
        "phone": { "type": "string", "description": "Contact phone number (10 digits)" },
        "message": { "type": "string", "maxLength": 500, "description": "Partnership inquiry message" },
        "notes": { "type": "string", "maxLength": 500, "description": "Internal notes" },
        "status": { "type": "string", "enum": ["new"], "description": "Partnership inquiry status" },
        "createdAt": { "type": "string", "description": "Server timestamp of enquiry" }
      },
      "required": ["company", "contactName", "email", "status", "createdAt"]
    },
    "Setting": {
      "title": "Setting",
      "description": "Global event configuration settings",
      "type": "object",
      "properties": {
        "registrationCap": { "type": "number", "description": "Maximum registered attendees before waitlist triggers (default 500)" },
        "registrationStatus": { "type": "string", "enum": ["open", "closed"], "description": "Registration status" },
        "showCount": { "type": "boolean", "description": "Whether to show registration counter" },
        "status": { "type": "string", "description": "Status mirror" },
        "updatedAt": { "type": "string", "description": "Timestamp of update" }
      },
      "required": ["registrationStatus"]
    },
    "Mail": {
      "title": "Mail",
      "description": "Trigger email document queued for Firebase Trigger Email extension",
      "type": "object",
      "properties": {
        "to": { "type": "array", "description": "Array of recipient email addresses" },
        "registrationId": { "type": "string", "maxLength": 64, "description": "Associated registration code" },
        "message": { "type": "object", "description": "Subject and text/html email body payload" },
        "createdAt": { "type": "string", "description": "Server timestamp of email queue entry" }
      },
      "required": ["to", "message", "createdAt"]
    }
  },
  "firestore": {
    "/counters/{counterId}": {
      "schema": "Counter",
      "description": "Sequential counters for unique registration IDs"
    },
    "/registrations/{registrationId}": {
      "schema": "Registration",
      "description": "Attendee registrations submitted by visitors keyed by email hash"
    },
    "/phoneIndex/{phoneHash}": {
      "schema": "PhoneIndex",
      "description": "Phone index records for duplicate detection keyed by phone hash"
    },
    "/partnerEnquiries/{enquiryId}": {
      "schema": "PartnerEnquiry",
      "description": "Partnership enquiries submitted by organizations"
    },
    "/settings/{settingId}": {
      "schema": "Setting",
      "description": "Global application and registration settings"
    },
    "/mail/{mailId}": {
      "schema": "Mail",
      "description": "Trigger email jobs for Firebase Trigger Email extension"
    }
  }
}
